<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForumReviewMonitor.MainWindow" Title="openEuler 论坛审核助手" Icon="Assets/openeuler.ico" Width="1100" Height="650" MinWidth="1040" MinHeight="650" Background="#F3F5F9" FontFamily="Microsoft YaHei UI" FontSize="13" WindowStartupLocation="CenterScreen">
  <DockPanel Margin="16,8,16,12">
    <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" Padding="16,8" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="166" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Source="Assets/openeuler-standard.png" Width="145" Height="32" Stretch="Uniform" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="论坛审核助手" Foreground="#163861" FontSize="20" FontWeight="SemiBold" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="v1.7.0" Foreground="#526078" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="8" Padding="10" Margin="0,8,0,0">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width=".85*" />
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition Width="1.1*" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="监控：已停止" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" x:Name="CheckStateText" Text="检查：尚未检查" />
          <TextBlock Grid.Column="2" x:Name="CountText" Text="待审核：—" />
          <TextBlock Grid.Column="3" x:Name="LastText" Text="上次检查：—" />
          <TextBlock Grid.Column="4" x:Name="SuccessText" Text="上次成功：—" />
          <TextBlock Grid.Column="5" x:Name="NextText" Text="下次检查：—" />
        </Grid>
        <TextBlock x:Name="FeedbackText" Text="请先填写凭据并验证认证。配置保存在程序旁的 data 目录。" TextWrapping="NoWrap" Foreground="#526078" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      </StackPanel>
    </Border>
    <Grid x:Name="NavigationLayout" SizeChanged="NavigationSizeChanged">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TabControl Background="White" Padding="12" SizeChanged="ContentSizeChanged" Grid.Row="1">
        <TabItem Header="待审核列表" Height="38">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="全部待处理类型；悬停查看完整标题，右键复制标题，双击打开审核项。" Foreground="#526078" Margin="0,0,0,8" TextWrapping="Wrap" />
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <StackPanel Orientation="Horizontal" Margin="0" DockPanel.Dock="Left">
                <Button Content="第一页" Click="ReviewPageClick" Tag="first" x:Name="ReviewFirst" />
                <Button Content="上一页" Click="ReviewPageClick" Tag="-1" x:Name="ReviewPrev" />
                <TextBlock x:Name="ReviewPageText" VerticalAlignment="Center" Margin="4,0,12,0" />
                <Button Content="下一页" Click="ReviewPageClick" Tag="1" x:Name="ReviewNext" />
                <Button Content="最后一页" Click="ReviewPageClick" Tag="last" x:Name="ReviewLast" />
              </StackPanel>
            </DockPanel>
            <DataGrid SizeChanged="ContentSizeChanged" x:Name="ReviewGrid" LoadingRow="ReviewRowLoaded" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="28" MouseDoubleClick="RowDoubleClick" EnableRowVirtualization="True" ColumnHeaderHeight="28" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="110" />
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                      <Setter Property="ToolTip" Value="{Binding Title}" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="115" />
                <DataGridTextColumn Header="提交时间" Binding="{Binding CreatedText}" Width="145" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="统计看板" Height="38">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,8,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="统计口径：发帖时间、进入审核列表时间取论坛数据；检测到时间取本地首次发现时间。处理完成时间优先取服务端审核历史，未返回时使用本地首次观察到完成的时间。" Foreground="#526078" TextWrapping="Wrap" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="导出 CSV" Click="ExportStatsClick" Margin="12,0,0,0" />
            </Grid>
            <UniformGrid DockPanel.Dock="Top" Columns="6" Margin="0,0,8,8">
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock x:Name="StatsTotalText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#163861" />
                  <TextBlock Text="累计收集" Foreground="#526078" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock x:Name="StatsCompletedText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#166534" />
                  <TextBlock Text="已完成审核" Foreground="#526078" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock x:Name="StatsPendingText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#B45309" />
                  <TextBlock Text="进行中" Foreground="#526078" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock x:Name="StatsAvgText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#163861" />
                  <TextBlock Text="平均耗时" Foreground="#526078" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock x:Name="StatsMedianText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#163861" />
                  <TextBlock Text="中位耗时" Foreground="#526078" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="10,8">
                <StackPanel>
                  <TextBlock x:Name="StatsLongestText" Text="—" FontSize="20" FontWeight="SemiBold" Foreground="#B42318" />
                  <TextBlock Text="待审最久" Foreground="#526078" Margin="0,2,0,0" />
                </StackPanel>
              </Border>
            </UniformGrid>
            <Border DockPanel.Dock="Top" Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,8,8">
              <StackPanel>
                <TextBlock Text="审核耗时分布（发帖到完成；发帖时间缺失时按进入审核列表时间）" FontSize="14" FontWeight="SemiBold" Foreground="#163861" />
                <StackPanel x:Name="DistributionPanel" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <DataGrid x:Name="StatsGrid" Margin="0,0,8,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="28" ColumnHeaderHeight="28">
              <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="90" />
                <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                      <Setter Property="ToolTip" Value="{Binding Title}" />
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="100" />
                <DataGridTextColumn Header="发帖时间" Binding="{Binding PostCreatedText}" Width="125" />
                <DataGridTextColumn Header="进入审核" Binding="{Binding QueuedText}" Width="125" />
                <DataGridTextColumn Header="检测到" Binding="{Binding DetectedText}" Width="125" />
                <DataGridTextColumn Header="处理完成" Binding="{Binding CompletedText}" Width="125" />
                <DataGridTextColumn Header="来源" Binding="{Binding CompletionSourceText}" Width="75" />
                <DataGridTextColumn Header="耗时" Binding="{Binding DurationText}" Width="95" />
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
        <TabItem Header="设置" Height="38">
          <Grid x:Name="SettingsLayout" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="LeftSettingsColumn">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="12,8" x:Name="AuthCard">
                <Grid x:Name="AuthSettingsPanel">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="论坛认证" FontSize="14" FontWeight="SemiBold" Foreground="#163861" Margin="0" Grid.Row="0" />
                  <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="论坛地址" Grid.Row="0" VerticalAlignment="Center" Margin="0" />
                    <TextBox x:Name="ForumBox" Margin="0" Grid.Row="0" Grid.Column="1" Padding="6,3" />
                  </Grid>
                  <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="76" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="认证方式" Grid.Row="0" VerticalAlignment="Center" Margin="0" />
                    <ComboBox x:Name="AuthBox" SelectedIndex="0" SelectionChanged="AuthChanged" Margin="0" Padding="6,3" Grid.Row="0" Grid.Column="1">
                      <ComboBoxItem Content="Cookie" />
                      <ComboBoxItem Content="API Key" />
                    </ComboBox>
                  </Grid>
                  <Grid x:Name="AuthConfigSlot" Height="24" Grid.Row="6">
                    <StackPanel x:Name="CookiePanel" VerticalAlignment="Top">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Cookie" Grid.Row="0" VerticalAlignment="Center" Margin="0" />
                        <PasswordBox x:Name="CookieBox" Margin="0" Grid.Row="0" Grid.Column="1" Padding="6,3" />
                      </Grid>
                    </StackPanel>
                    <StackPanel x:Name="ApiPanel" Visibility="Collapsed" VerticalAlignment="Top">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="76" />
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="68" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="API Key" Grid.Column="0" VerticalAlignment="Center" />
                        <TextBlock Text="用户名" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <PasswordBox x:Name="ApiKeyBox" Margin="0" Grid.Row="0" Grid.Column="1" Padding="6,3" />
                        <TextBox x:Name="UsernameBox" Margin="0" Grid.Row="0" Grid.Column="3" Padding="6,3" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="76,0,0,0" Grid.Row="8">
                    <Button x:Name="ValidateButton" Content="验证认证" Click="ValidateClick" Padding="10,4" />
                    <Button Content="保存认证" Click="SaveAuthClick" Padding="10,4" />
                  </StackPanel>
                  <Border x:Name="AuthResultPanel" Background="#EDF2F8" BorderBrush="#D7E0EA" BorderThickness="1" CornerRadius="6" Padding="8,4" VerticalAlignment="Top" Margin="0" Height="44" Grid.Row="10">
                    <StackPanel>
                      <TextBlock x:Name="AuthResultTitle" Text="尚未验证" FontSize="12" FontWeight="SemiBold" />
                      <TextBlock x:Name="AuthResultText" Text="填写 Cookie 或 API Key 后点击“验证认证”，结果会显示在这里。" TextWrapping="NoWrap" Margin="0,2,0,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0" x:Name="MonitorCard" Grid.Row="1">
                <Grid x:Name="MonitorSettingsPanel">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <DockPanel Margin="0" Grid.Row="0">
                    <TextBlock Text="监控选项" FontSize="14" FontWeight="SemiBold" Foreground="#163861" Margin="0" VerticalAlignment="Center" />
                  </DockPanel>
                  <Grid Grid.Row="2" Margin="0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="88" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="检查间隔（分）" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="重复提醒（分）" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Grid Width="88" Margin="0" HorizontalAlignment="Left" Height="28" Grid.Row="0" Grid.Column="1">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="IntervalBox" PreviewKeyDown="TimeKeyDown" Padding="8,0" VerticalContentAlignment="Center" />
                      <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition />
                        </Grid.RowDefinitions>
                        <RepeatButton Tag="Interval,+" Click="AdjustTimeClick" ToolTip="增加 1 分钟" Delay="400" Interval="100" Padding="0">
                          <Path Data="M 0,5 L 4,0 L 8,5 Z" Width="8" Height="5" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RepeatButton>
                        <RepeatButton Grid.Row="1" Tag="Interval,-" Click="AdjustTimeClick" ToolTip="减少 1 分钟" Delay="400" Interval="100" Padding="0">
                          <Path Data="M 0,0 L 8,0 L 4,5 Z" Width="8" Height="5" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RepeatButton>
                      </Grid>
                    </Grid>
                    <Grid Width="88" Margin="0" HorizontalAlignment="Left" Height="28" Grid.Row="0" Grid.Column="4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                      </Grid.ColumnDefinitions>
                      <TextBox x:Name="RepeatBox" PreviewKeyDown="TimeKeyDown" Padding="8,0" VerticalContentAlignment="Center" />
                      <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                          <RowDefinition />
                          <RowDefinition />
                        </Grid.RowDefinitions>
                        <RepeatButton Tag="Repeat,+" Click="AdjustTimeClick" ToolTip="增加 1 分钟" Delay="400" Interval="100" Padding="0">
                          <Path Data="M 0,5 L 4,0 L 8,5 Z" Width="8" Height="5" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RepeatButton>
                        <RepeatButton Grid.Row="1" Tag="Repeat,-" Click="AdjustTimeClick" ToolTip="减少 1 分钟" Delay="400" Interval="100" Padding="0">
                          <Path Data="M 0,0 L 8,0 L 4,5 Z" Width="8" Height="5" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RepeatButton}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </RepeatButton>
                      </Grid>
                    </Grid>
                  </Grid>
                  <TextBlock Text="默认 15 分钟检查；重复提醒为 0 时仅提醒新增项。" FontSize="12" Foreground="#526078" Margin="0" Grid.Row="4" />
                </Grid>
              </Border>
            </Grid>
            <Border Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="12,0" Grid.Column="2" VerticalAlignment="Stretch" x:Name="PushChannelCard">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,8,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="推送渠道" FontSize="14" FontWeight="SemiBold" Foreground="#163861" Margin="0" Grid.Row="0" />
                    <Border Background="#E8F5EC" Padding="8" CornerRadius="4" Margin="0" Grid.Row="2">
                      <TextBlock x:Name="EnabledChannelsText" FontWeight="SemiBold" Foreground="#166534" TextWrapping="Wrap" />
                    </Border>
                    <StackPanel x:Name="PushSettingsPanel" Grid.Row="4" Margin="0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="112" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="配置渠道" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,10,10" />
                        <ComboBox x:Name="ChannelBox" SelectedIndex="0" SelectionChanged="ChannelChanged" Padding="6,3" Margin="0,0,0,10" HorizontalAlignment="Stretch" Width="Auto" Grid.Row="0" Grid.Column="1" Height="24">
                          <ComboBoxItem Content="Windows 通知" />
                          <ComboBoxItem Content="企业微信" />
                          <ComboBoxItem Content="钉钉" />
                          <ComboBoxItem Content="飞书" />
                        </ComboBox>
                      </Grid>
                      <Grid x:Name="ChannelConfigSlot" Height="90">
                        <Border x:Name="WindowsConfig" Padding="0" Margin="0" BorderThickness="0" VerticalAlignment="Top">
                          <TextBlock Text="Windows 通知始终启用，无需配置。启用群机器人后，Windows 仍会同步通知。" TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="WeComConfig" Visibility="Collapsed" Padding="0" Margin="0" BorderThickness="0" VerticalAlignment="Top">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="112" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="30" />
                              <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="WeComEnabled" Content="启用企业微信群机器人" Grid.ColumnSpan="2" Margin="0,0,0,6" Height="24" VerticalAlignment="Top" VerticalContentAlignment="Center" />
                            <TextBlock Text="Webhook" Grid.Row="1" Grid.Column="0" Margin="0,0,0,6" VerticalAlignment="Center" />
                            <PasswordBox x:Name="WeComHook" Margin="0,0,0,6" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Padding="6,3" Height="24" VerticalContentAlignment="Center" />
                          </Grid>
                        </Border>
                        <Border x:Name="DingConfig" Visibility="Collapsed" Padding="0" Margin="0" BorderThickness="0" VerticalAlignment="Top">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="112" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="30" />
                              <RowDefinition Height="30" />
                              <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="DingEnabled" Content="启用钉钉群机器人" Grid.ColumnSpan="2" Margin="0,0,0,6" Height="24" VerticalAlignment="Top" VerticalContentAlignment="Center" />
                            <TextBlock Text="Webhook" Grid.Row="1" Grid.Column="0" Margin="0,0,0,6" VerticalAlignment="Center" />
                            <PasswordBox x:Name="DingHook" Margin="0,0,0,6" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Padding="6,3" Height="24" VerticalContentAlignment="Center" />
                            <TextBlock Text="签名密钥（选填）" Grid.Row="2" Grid.Column="0" Margin="0,0,0,6" VerticalAlignment="Center" ToolTip="加签密钥（启用加签时填写）" />
                            <PasswordBox x:Name="DingSecret" Margin="0,0,0,6" Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Padding="6,3" Height="24" VerticalContentAlignment="Center" />
                          </Grid>
                        </Border>
                        <Border x:Name="FeishuConfig" Visibility="Collapsed" Padding="0" Margin="0" BorderThickness="0" VerticalAlignment="Top">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="112" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="30" />
                              <RowDefinition Height="30" />
                              <RowDefinition Height="30" />
                            </Grid.RowDefinitions>
                            <CheckBox x:Name="FeishuEnabled" Content="启用飞书群机器人" Grid.ColumnSpan="2" Margin="0,0,0,6" Height="24" VerticalAlignment="Top" VerticalContentAlignment="Center" />
                            <TextBlock Text="Webhook" Grid.Row="1" Grid.Column="0" Margin="0,0,0,6" VerticalAlignment="Center" />
                            <PasswordBox x:Name="FeishuHook" Margin="0,0,0,6" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Padding="6,3" Height="24" VerticalContentAlignment="Center" />
                            <TextBlock Text="签名密钥（选填）" Grid.Row="2" Grid.Column="0" Margin="0,0,0,6" VerticalAlignment="Center" ToolTip="签名密钥（启用签名校验时填写）" />
                            <PasswordBox x:Name="FeishuSecret" Margin="0,0,0,6" Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" Padding="6,3" Height="24" VerticalContentAlignment="Center" />
                          </Grid>
                        </Border>
                      </Grid>
                      <StackPanel Orientation="Horizontal">
                        <Button x:Name="TestButton" Content="测试 Windows 通知" Click="TestClick" Padding="10,4" Width="170" />
                        <Button x:Name="SaveChannelButton" Content="保存当前渠道" Click="SaveChannelClick" Visibility="Collapsed" Padding="10,4" Width="170" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <Border x:Name="PushResultPanel" Background="#EDF2F8" CornerRadius="6" Padding="8" Margin="0,8,0,8" Height="68" Grid.Row="2">
                    <StackPanel>
                      <TextBlock x:Name="PushResultTitle" Text="尚未测试" FontSize="13" FontWeight="SemiBold" />
                      <TextBlock x:Name="PushResultText" Text="点击当前渠道的测试按钮，结果会显示在这里。" TextWrapping="Wrap" Margin="0,4,0,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" TextTrimming="CharacterEllipsis" FontSize="12" LineHeight="16" LineStackingStrategy="BlockLineHeight" Height="32" />
                    </StackPanel>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <Border x:Name="CloseBehaviorPanel" Grid.Row="1" Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="其他配置" FontSize="14" FontWeight="SemiBold" Foreground="#163861" Margin="0,0,0,10" />
                <CheckBox x:Name="CloseTrayBox" Content="关闭窗口后隐藏到托盘" Margin="0" VerticalAlignment="Center" ToolTip="勾选后关闭窗口会隐藏到托盘；取消后直接退出。修改立即生效并自动保存。" />
              </StackPanel>
            </Border>
            <Border x:Name="AboutPanel" Grid.Row="1" Grid.Column="2" Background="#F7F9FC" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
              <StackPanel>
                <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" Foreground="#163861" Margin="0,0,0,10" />
                <TextBlock Text="openEuler 论坛审核助手 · v1.7.0" Foreground="#526078" Margin="0,0,0,4" />
                <TextBlock Text="作者：yanzhicong    © 2026 yanzhicong" Foreground="#526078" Margin="0,0,0,4" />
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>
        <TabItem x:Name="LogTab" Header="运行日志" Height="38">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
              <Button Content="复制日志" Click="CopyLogsClick" />
              <Button Content="导出全部日志" Click="ExportLogsClick" />
              <CheckBox x:Name="AutoScrollLogs" Content="自动滚动" IsChecked="True" VerticalAlignment="Center" Checked="LogFollowChanged" />
            </StackPanel>
            <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas, Microsoft YaHei UI" />
          </DockPanel>
        </TabItem>
      </TabControl>
      <StackPanel x:Name="ActionBar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="StartButton" Content="启动监控" Click="ToggleMonitorClick" Background="#2563EB" Foreground="White" Height="38" Width="140" Margin="0,0,8,0" />
        <Button x:Name="CheckButton" Content="立即检查" Click="CheckClick" Height="38" Width="140" Margin="0,0,8,0" />
        <Button Content="打开审核页面" Click="ReviewClick" Height="38" Width="140" Margin="0" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
